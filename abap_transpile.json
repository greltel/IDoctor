{
  "input_folder": "src",
  "input_filter": [],
  "exclude_filter": [
    "/demos/",
    "zcl_idoctor_repository\\.clas\\.testclasses\\.abap$"
  ],
  "output_folder": "output",
  "libs": [
    {
      "folder": "node_modules/open-abap-core",
      "files": "/src/**/*.*"
    },
    {
      "folder": "transpiler/ddic",
      "files": "/**/*.*"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "compileError",
    "skip": [
      {
        "object": "ZCL_IDOCTOR",
        "class": "ltc_idoctor",
        "method": "given_special_chars_xml_escape"
      }
    ]
  }
}
